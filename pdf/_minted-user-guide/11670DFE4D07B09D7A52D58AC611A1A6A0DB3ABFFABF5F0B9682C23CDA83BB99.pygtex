\begin{Verbatim}[commandchars=\\\{\}]
\PYG{p}{;}\PYG{c}{! Additive error}
\PYG{n}{Y}\PYG{o}{=}\PYG{n}{F}\PYG{o}{+}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}

\PYG{p}{;}\PYG{c}{! proportional error}
\PYG{n}{Y}\PYG{o}{=}\PYG{n}{F}\PYG{o}{+}\PYG{n}{F}\PYG{o}{*}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{;}\PYG{c}{! equivalently Y=F*(1+ERR(1))}

\PYG{p}{;}\PYG{c}{! exponential error (proportional error in log\PYGZhy{}scale)}
\PYG{n}{Y}\PYG{o}{=}\PYG{n}{F}\PYG{o}{*}\PYG{n+nb}{EXP}\PYG{p}{(}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{))}

\PYG{p}{;}\PYG{c}{! combined additive and proportional error}
\PYG{n}{Y}\PYG{o}{=}\PYG{n}{F}\PYG{o}{+}\PYG{n}{F}\PYG{o}{*}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{o}{+}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)}

\PYG{p}{;}\PYG{c}{! power error model}
\PYG{p}{;}\PYG{c}{! variable P must be assigned a value, typically identified as a THETA element.}
\PYG{n}{Y}\PYG{o}{=}\PYG{n}{F}\PYG{o}{+}\PYG{n}{F}\PYG{o}{**}\PYG{n}{P}\PYG{o}{*}\PYG{n}{ERR}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}
\end{Verbatim}
