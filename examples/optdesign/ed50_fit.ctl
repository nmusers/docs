$PROBLEM EDS50 Model Visual Acuity
$INPUT C ID TIME DOSEQ MDV DV 
$DATA ed50s_fit.dat ignore=@

$PRED
MU_1=LOG(THETA(1))
MU_2=LOG(THETA(2))
MU_3=LOG(THETA(3))
MU_4=LOG(THETA(4))
MU_5=LOG(THETA(5))

IF(MDV==1) THEN
DOSE=DOSEQ
ELSE
DOSE=DOSE
ENDIF

VA0=EXP(MU_1+ETA(1))
KK=EXP(MU_2+ETA(2))
BETA=EXP(MU_3+ETA(3))

EMAX=EXP(MU_4+ETA(4))
ED50=EXP(MU_5+ETA(5))

EE=EMAX*DOSE/(ED50+DOSE)

IPRED=VA0+(1.0-EXP(-KK*TIME))*(EE-BETA*VA0)
Y=IPRED + EPS(1)

$THETA
55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
30.0     ;[EMAXS]
150.0    ;[ED50S]

$OMEGA 0.07 0.5 1.0 0.17 0.49
$SIGMA 28.0

$EST METHOD=1 INTERACTION MAXEVAL=999 PRINT=1 NOHABORT
$COV MATRIX=R PRINT=E UNCONDITIONAL

