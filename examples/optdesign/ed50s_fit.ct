$PROBLEM EDS50 Model Visual Acuity
$INPUT C ID TIME DOSEQ MDV DV MDL  TSTRAT  TMIN TMAX DSTRAT DMIN DMAX    STRAT   STRATF
$DATA ed50s.dat ignore=C

$PRED
MU_1=LOG(THETA(1))
MU_2=LOG(THETA(2))
MU_3=LOG(THETA(3))
MU_4=LOG(THETA(4))
MU_5=LOG(THETA(5))
MU_6=LOG(THETA(6))

IF(MDV==1) THEN
DOSE=DOSEQ
ELSE
DOSE=DOSE
ENDIF

VA0=EXP(MU_1+ETA(1))
KK=EXP(MU_2+ETA(2))
BETA=EXP(MU_3+ETA(3))

EMAXS=EXP(MU_4+ETA(4))
ED50S=EXP(MU_5+ETA(5))
GAMM=EXP(MU_6+ETA(6))

DG=DOSE**GAMM
EE=EMAXS*DG/((ED50S**GAMM)+DG)

IPRED=VA0+(1.0-EXP(-KK*TIME))*(EE-BETA*VA0)
Y=IPRED + EPS(1)

$THETA
55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
30.0     ;[EMAXS]
150.0    ;[ED50S]
(2.0 FIXED) ;[GAMM]

$OMEGA 0.07 0.5 1.0 0.17 0.49 (0.0 FIXED)
$SIGMA 28.0

$DESIGN GROUPSIZE=168 FIMDIAG=1 MAXEVAL=9999 PRINT=20
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$DESIGN GROUPSIZE=168 FIMDIAG=1 MAXEVAL=9999 PRINT=20
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$TABLE ID MDL STRATF DOSE TIME TSTRAT TMIN TMAX MDV IPRED NOAPPEND NOPRINT FILE=ed50s.tab
