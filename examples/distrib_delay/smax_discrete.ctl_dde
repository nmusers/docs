;DDE
;$SIZES MAXNDRS=1 ; SUGGESTED VALUE FOR MAXNRDS.  UNCOMMENT TO USE
$PROBLEM Discrete Delay on Smax Drug Responsive Input function
$ABBR FUNCTION DDEFUNC(VDDE,4)
; turn off second derivative assessments, sometimes even 1st derivatives if only simulating
$ABBR DERIV2=NO DERIV2=NOCOMMON DERIV1=NO
$INPUT ID AMT TIME DV EVID MDV
$DATA smax_discrete.dat IGNORE=C
$SUBROUTINES ADVAN18 TOL=10 ATOL=10 ; OTHER=ddeslvu.f90
$MODEL NCOMPARTMENTS=2

$PK
CALLFL=-2
MXSTEP=2000000000
SMAX=THETA(1)
SC50=THETA(2)
KIN0=THETA(3)
AA=THETA(4)
BB=THETA(5)
TAU1 = aa*dexp(gamln(1.0+1.0/bb))

Vmax = 2
V50 = 3
V = 1

; Initial conditions
A_0(1)=0.0
A_0(2)=5.0


; INITIALIZING EQUATIONS FOR DDE COMPARTMENTS
  TAU_1=1*TAU1

$DES

; DELAY SETUP FOR EQUATION SET 1
   AP_1_1=0.0
    DTAU_1=0.0
     IF((T-PASTZERO)>=TAU_1) DTAU_1=1.0
  VDDE(1)=TAU_1
  VDDE(2)=T
    VDDE(3)=1
  VDDE(4)=1
  AZ_1_1=DDEFUNC(VDDE)
    AD_1_1=(1.0-DTAU_1)*AP_1_1+DTAU_1*AZ_1_1

; DELAY EQUATIONS FOR EQUATION SET 0 (BASE EQUATIONS)
 C=A(1)/V
 KIN=KIN0*(1.0+(SMAX*C)/(SC50+C))
 CDELAY=AD_1_1/V
 KINDELAY=KIN0*(1.0+(SMAX*CDELAY)/(SC50+CDELAY))

 DADT(1)=-(VMAX*A(1))/(V50+A(1))
 DADT(2)=KIN-KINDELAY


$ERROR
A1=A(2)
Y1=1.0
IPRED=A(2)
Y=IPRED*(1.0+EPS(1))

$THETA
0.5
10.0
0.8
7.0
6.5

$OMEGA (0.0 fixed)x4
$SIGMA (0.0 fixed)
$SIML (122345) ONLYSIM SUBP=1
$TABLE TIME KIN IPRED NOPRINT NOAPPEND FILE=smax_discrete.tab ONEHEADER FORMAT=S1PE20.13
