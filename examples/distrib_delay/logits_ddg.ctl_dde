;DDE
;$SIZES MAXNDRS=1 ; SUGGESTED VALUE FOR MAXNRDS.  UNCOMMENT TO USE
$PROBLEM LOGISTIC
$ABBR VECTOR VECGQ1(7)
$ABBR DECLARE DOWHILE II_1
$ABBR DECLARE INTEGER NN_1
$ABBR FUNCTION GQ(*,7)
$ABBR FUNCTION DDEFUNC(VDDE,15)
$ABBR DERIV2=NO DERIV2=NOCOMMON ; DERIV1=NO
$INPUT ID AMT TIME PRDV DV EVID MDV
$DATA logistic6.csv IGNORE=C
$SUBROUTINES ADVAN16 TOL=6 ATOL=6
$MODEL NCOMPARTMENTS=1

$PK
MXSTEP=2000000000
MU_1=THETA(1)
MU_2=THETA(2)
MU_3=THETA(3)
MU_4=THETA(4)
MU_5=THETA(5)
KG=EXP(MU_1+ETA(1))
Y0=EXP(MU_2+ETA(2))
YSS=EXP(MU_3+ETA(3))
KK=EXP(MU_4+ETA(4))
NU1=EXP(MU_5+ETA(5))
DEN=KK/EXP(GAMLN(NU1))
A_0(1)=Y0

  ETZ_1=ETA(1)
  ETZ_2=ETA(2)
  ETZ_3=ETA(3)
  ETZ_4=ETA(4)
  ETZ_5=ETA(5)

; INITIALIZING EQUATIONS FOR DDE COMPARTMENTS

$DES

 ADC=0.0
NN_1=10
VECGQ1(3)=NN_1
VECGQ1(4)=-1
VECGQ1(5)=NU1
VECGQ1(6)=KK
VECGQ1(7)=1
;DOC1 10 TS CS GQ(GAM,NU1,KK)
II_1=1
DOWHILE (II_1<=NN_1)
VECGQ1(1)=II_1
VECGQ1(2)=0
TS=GQ(VECGQ1)
VECGQ1(2)=1
CS=GQ(VECGQ1)
 TAU1=TS
  TAU_1=TAU1
   AP_1_1=Y0
    DTAU_1=0.0
     IF((T-PASTZERO)>=TAU_1) DTAU_1=1.0
  VDDE(1)=TAU_1
  VDDE(2)=T
    VDDE(3)=1
  VDDE(4)=1
  VDDE(5)=1
  VDDE(6)=ETZ_1
  VDDE(7)=2
  VDDE(8)=ETZ_2
  VDDE(9)=3
  VDDE(10)=ETZ_3
  VDDE(11)=4
  VDDE(12)=ETZ_4
  VDDE(13)=5
  VDDE(14)=ETZ_5
  VDDE(15)=0
  AZ_1_1=DDEFUNC(VDDE)
    AD_1_1=(1.0-DTAU_1)*AP_1_1+DTAU_1*AZ_1_1
 ADC=ADC+CS*AD_1_1
;ENDDOC1
II_1=II_1+1
ENDDO

 DADT(1)=KG*(1.0-ADC/YSS)*A(1)


$ERROR
A1=A(1)
Y1=1.0
IPRED=A(1)
Y=IPRED*(1.0+EPS(1))

$THETA
-1.61764E+00
-2.40835E-02
 2.29145E+00
 -0.5
 1.098612289

$OMEGA BLOCK(3)
 8.45335E-03
 6.59591E-04  7.39132E-03
 1.01727E-03 -1.73680E-03  6.86871E-03

$OMEGA 0.01 0.01

$SIGMA
 3.23154E-03

;$SIML (122345) SUBP=1

;$EST METHOD=IMP AUTO=1 NOABORT PRINT=1
$EST METHOD=CHAIN FILE=temp14.ext ISAMPLE=-1000000000 TBLN=1 NSAMPLE=0
$EST METHOD=ITS INTERACTION NOHABORT SIGL=5 MCETA=10 NSIG=2 PRINT=1 NITER=0 CTYPE=3 OPTMAP=0 ETADER=0 FNLETA=0
$EST METHOD=ITS INTERACTION NOHABORT SIGL=5 MCETA=10 NSIG=2 PRINT=1 NITER=0 CTYPE=3 OPTMAP=1 ETADER=2 FNLETA=0
;$EST METHOD=ITS INTERACTION NOABORT SIGL=3 SIGLO=8 MCETA=10 NSIG=1 PRINT=1 NITER=100 CTYPE=3 FAST OPTMAP=0 ETADER=0
;$EST METHOD=IMP INTERACTION MAXEVAL=9999 NOHABORT SIGL=4 NSIG=1 PRINT=1 NITER=5 CTYPE=3 MAPITER=0 ISAMPLE=100
;     RANMETHOD=S2
;$COV MATRIX=R UNCONDITIONAL

