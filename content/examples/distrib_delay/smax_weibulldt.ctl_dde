;DDE
;NN1=100
;PRC=0.01
;DISTRIB=WEIBULLCDF(VG)
$SIZES PC=110
$PROBLEM LOGISTIC Distributed transit compartments on Smax Drug Responsive Input function
; turn off second derivative assessments, sometimes even 1st derivatives if only simulating
$ABBR FUNCTION TRANSITG_SDIM1(VG,113)
$ABBR FUNCTION WEIBULLCDF(*,10)
$ABBR FUNCTION WEIBULLCDFINV(*,10)
$ABBR DERIV2=NO DERIV2=NOCOMMON DERIV1=NO
$INPUT ID AMT TIME DV EVID MDV
$DATA smax_weibull.dat IGNORE=C
$SUBROUTINES ADVAN13 TOL=10 ATOL=10
$MODEL NCOMPARTMENTS=102

$PK
CALLFL=-2
MXSTEP=2000000000
SMAX=THETA(1)
SC50=THETA(2)
KIN0=THETA(3)
AA=THETA(4)
BB=THETA(5)
Vmax = 2
V50 = 3
V = 1

VG(2)=AA
VG(3)=BB

; Initial conditions
A_0(1)=0.0
A_0(2)=5.0


; INITIALIZING EQUATIONS FOR DDE COMPARTMENTS

$DES
" FIRST
" EXTERNAL WEIBULLCDF
 VG(2)=AA
 VG(3)=BB





; DELAY SETUP FOR EQUATION SET 1
 C=A(1)/V
 KIN=KIN0*(1.0+(SMAX*C)/(SC50+C))
 APG_KIN_1=KIN0
  TZ_GD=T-PASTZERO
 T_O=0.0
  IF(TZ_GD>=0.0) T_O=1.0
NNU_1=100
VG(1)=1.0-0.01
TTEND_1=WEIBULLCDFINV(VG)
KK_1=NNU_1/TTEND_1
DTT_1=1.0/KK_1
IF(TTEND_1==-1.0D+300) EXIT 2
VG(1)=DTT_1
"VG(11)=LOC(WEIBULLCDF)
VG(12)=-1.0D+300
    DADT(3)=KK_1*(KIN-A(3)-APG_KIN_1)
