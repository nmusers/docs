;$SIZES MAXNRDS=1 PAST_SIZE=10000
;$SIZES MAXNDRS=1 ; SUGGESTED VALUE FOR MAXNRDS.  UNCOMMENT TO USE
$PROBLEM RA
$ABBR FUNCTION DDEFUNC(VDDE,11)
$ABBR DERIV2=NO DERIV2=NOCOMMON DES=FULL ; DERIV1=NO
$INPUT ID TIME  AMT  RATE II ADDL CMT  EVID MDV  DV
$DATA simpleDii16_2e.csv IGNORE=C
$SUBROUTINES ADVAN16 TOL=10 ATOL=10 SSTOL=6 SSATOL=6
$MODEL NCOMPARTMENTS=4

$PK
ADDLA=ADDL_ACTUAL
ADDLTIME=ADDL_TIME
MXSTEP=200000000
K10=THETA(1)+ETA(1)
K12=THETA(2)+ETA(2)
K21=THETA(3)+ETA(3)
V1=1.0
S1=V1
KEO=THETA(4)
K40=THETA(5)
TAU1=THETA(6)
" AQ=0.0
	
  ETZ_1=ETA(1)
  ETZ_2=ETA(2)
  ETZ_3=ETA(3)

; INITIALIZING EQUATIONS FOR DDE COMPARTMENTS

$DES
 PASTZERO=0.0
  TAU_1=TAU1
   AP_1_1=0.0
    DTAU_1=0.0
     IF((T-PASTZERO)>=TAU_1) DTAU_1=1.0
  VDDE(1)=TAU_1
  VDDE(2)=T
    VDDE(3)=1
  VDDE(4)=1
  VDDE(5)=1
  VDDE(6)=ETZ_1
  VDDE(7)=2
  VDDE(8)=ETZ_2
  VDDE(9)=3
  VDDE(10)=ETZ_3
  VDDE(11)=0
  AZ_1_1=DDEFUNC(VDDE)
    AD_1_1=(1.0-DTAU_1)*AP_1_1+DTAU_1*AZ_1_1

 DADT(1)=-K10*A(1)-K12*A(1)+K21*A(2)
 DADT(2)=K12*A(1)-K21*A(2)
 DADT(3)=KEO*A(1)-KEO*AD_1_1
 DADT(4)=KEO*AD_1_1-K40*A(4)

 AQ=AD_1_1


$ERROR

IPRED=A(1)/V1
Y=IPRED*(1.0+EPS(1))
A1=A(1)
A2=A(2)
A3=A(3)
A4=A(4)
A5=0.0
" A5=AQ

$THETA
0.17 ; [K10]
0.37 ; [K12]
0.25 ; [K21]
0.2   ; KEO
0.05  ; K40
4.0 ; [TAU1]

$OMEGA (0.0 FIXED) (0.0 FIXED) (0.0 FIXED)
$SIGMA (0.0 FIXED)

$SIMULATION (567811 NORMAL) ONLYSIMULATION SUBPROBLEMS=1

$TABLE ID ADDLTIME A1 A2 A3 A4 A5 EVID ADDL ADDLA NOAPPEND NOPRINT ONEHEADER
FILE=simpledii16_2e.tab
