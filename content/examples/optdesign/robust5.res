$PROBLEM Robust Visual Acuity
$INPUT C ID TIME DOSEQ MDV DV MDL  TSTRAT  TMIN TMAX DSTRAT DMIN DMAX    STRAT   STRATF
$DATA robust2.dat ignore=C

$SUBROUTINES OTHER=robust5_wfims.f90

$PRED
MU_1=LOG(THETA(1))
MU_2=LOG(THETA(2))
MU_3=LOG(THETA(3))
MU_4=LOG(THETA(4))
MU_5=LOG(THETA(5))
MU_6=LOG(THETA(6))
MU_7=LOG(THETA(7))
MU_8=LOG(THETA(8))
MU_9=LOG(THETA(9))
MU_10=LOG(THETA(10))
MU_11=LOG(THETA(11))
MU_12=LOG(THETA(12))
MU_13=LOG(THETA(13))
MU_14=LOG(THETA(14))
MU_15=LOG(THETA(15))
MU_16=LOG(THETA(16))
MU_17=LOG(THETA(17))
MU_18=LOG(THETA(18))

IF(MDV==1) THEN
DOSE=DOSEQ
ELSE
DOSE=DOSE
ENDIF

VA01=EXP(MU_1+ETA(1))
KK1=EXP(MU_2+ETA(2))
BETA1=EXP(MU_3+ETA(3))
ALPHAL=EXP(MU_4+ETA(4))

VA02=EXP(MU_5+ETA(5))
KK2=EXP(MU_6+ETA(6))
BETA2=EXP(MU_7+ETA(7))
ALPHALL=EXP(MU_8+ETA(8))

VA03=EXP(MU_9+ETA(9))
KK3=EXP(MU_10+ETA(10))
BETA3=EXP(MU_11+ETA(11))
EMAX=EXP(MU_12+ETA(12))
ED50=EXP(MU_13+ETA(13))

VA04=EXP(MU_14+ETA(14))
KK4=EXP(MU_15+ETA(15))
BETA4=EXP(MU_16+ETA(16))
EMAXS=EXP(MU_17+ETA(17))
ED50S=EXP(MU_18+ETA(18))
GAMM=2.0

DG=DOSE**GAMM
VA0=VA01
KK=KK1
BETA=BETA1

IF (MDL==1) VA0=VA01
IF (MDL==1) KK=KK1
IF (MDL==1) BETA=BETA1
IF(MDL==1) EE=ALPHAL*DOSE

IF (MDL==2) VA0=VA02
IF (MDL==2) KK=KK2
IF (MDL==2) BETA=BETA2
IF(MDL==2) EE=ALPHALL*LOG(DOSE+1.0)

IF (MDL==3) VA0=VA03
IF (MDL==3) KK=KK3
IF (MDL==3) BETA=BETA3
IF(MDL==3) EE=EMAX*DOSE/(ED50+DOSE)

IF (MDL==4) VA0=VA04
IF (MDL==4) KK=KK4
IF (MDL==4) BETA=BETA4
IF(MDL==4) EE=EMAXS*DG/(ED50S**GAMM+DG)

IPRED=VA0+(1.0-EXP(-KK*TIME))*(EE-BETA*VA0)

IF(MDL==1) Y=IPRED + EPS(1)
IF(MDL==2) Y=IPRED + EPS(2)
IF(MDL==3) Y=IPRED + EPS(3)
IF(MDL==4) Y=IPRED + EPS(4)

$THETA
55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
0.03     ; ALPHAL]

55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
3.5      ;[ALPHALL]

55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
30.0     ;[EMAX]
150.0    ;[ED50]

55.0     ;[VA0]
0.005    ;[KK]
0.2      ; [BETA]
30.0     ;[EMAXS]
150.0    ;[ED50S]

$OMEGA 
0.07 0.5 1.0 0.1 
0.07 0.5 1.0 0.122 
0.07 0.5 1.0 0.17 0.49 
0.07 0.5 1.0 0.17 0.49

$SIGMA 28.0
$SIGMA 28.0
$SIGMA 28.0
$SIGMA 28.0

$DESIGN GROUPSIZE=42 FIMDIAG=1 MAXEVAL=200 PRINT=20 OFVDIMSCALED=1
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$DESIGN GROUPSIZE=42 FIMDIAG=1 MAXEVAL=200 PRINT=20 OFVDIMSCALED=1
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$DESIGN GROUPSIZE=42 FIMDIAG=1 MAXEVAL=200 PRINT=20 OFVDIMSCALED=1
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$DESIGN GROUPSIZE=42 FIMDIAG=1 MAXEVAL=200 PRINT=20 OFVDIMSCALED=1
        DESEL=TIME DESELSTRAT=TSTRAT DESELMIN=TMIN DESELMAX=TMAX
        DESEL=DOSEQ DESELSTRAT=DSTRAT DESELMIN=DMIN DESELMAX=DMAX
        STRAT=STRAT STRATF=STRATF

$TABLE ID MDL STRATF DOSE TIME TSTRAT TMIN TMAX MDV IPRED NOAPPEND NOPRINT FILE=robust5.tab
  
NM-TRAN MESSAGES 
  
 WARNINGS AND ERRORS (IF ANY) FOR PROBLEM    1
             
